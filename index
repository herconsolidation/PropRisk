<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prop Firm Risk & Consistency Calculator</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        slate: {
                            850: '#111827',
                            900: '#0f172a',
                            950: '#020617',
                        },
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
            transition: background-color 0.2s ease, color 0.2s ease;
        }

        /* Light Theme Comprehensive Styling */
        html:not(.dark) body {
            background-color: #f8fafc;
            color: #0f172a;
        }

        /* Headers & Navbars */
        html:not(.dark) header {
            background-color: rgba(255, 255, 255, 0.9) !important;
            border-color: #e2e8f0 !important;
        }
        html:not(.dark) header h1 {
            color: #0f172a !important;
        }
        html:not(.dark) footer {
            background-color: #ffffff !important;
            border-color: #e2e8f0 !important;
            color: #64748b !important;
        }

        /* Cards & Containers */
        html:not(.dark) section,
        html:not(.dark) .lg\:col-span-7 > div,
        html:not(.dark) .lg\:col-span-6 > div,
        html:not(.dark) .lg\:col-span-5 > div {
            background-color: #ffffff !important;
            border-color: #e2e8f0 !important;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05) !important;
        }

        /* Inner Sub-cards & Containers */
        html:not(.dark) .bg-slate-950,
        html:not(.dark) .bg-slate-950\/80,
        html:not(.dark) .bg-slate-950\/60 {
            background-color: #f1f5f9 !important;
            border-color: #cbd5e1 !important;
        }

        /* Typography Override for Light Mode */
        html:not(.dark) h2,
        html:not(.dark) h3,
        html:not(.dark) h4 {
            color: #0f172a !important;
        }
        html:not(.dark) label,
        html:not(.dark) .text-slate-300,
        html:not(.dark) .text-slate-200 {
            color: #334155 !important;
        }
        html:not(.dark) .text-slate-400 {
            color: #64748b !important;
        }
        html:not(.dark) .text-slate-500 {
            color: #64748b !important;
        }
        html:not(.dark) .text-white {
            color: #0f172a !important;
        }

        /* Header Quick Rule Chips in Light Mode */
        html:not(.dark) header .bg-slate-800 {
            background-color: #f1f5f9 !important;
            border-color: #cbd5e1 !important;
            color: #334155 !important;
        }
        html:not(.dark) header .text-white {
            color: #0f172a !important;
        }

        /* Theme Toggle Button */
        html:not(.dark) #themeBtn {
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #334155 !important;
        }

        /* Inputs, Selects & Buttons */
        html:not(.dark) input[type="number"],
        html:not(.dark) input[type="text"],
        html:not(.dark) select {
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
        }
        html:not(.dark) input[type="number"]:focus,
        html:not(.dark) select:focus {
            border-color: #2563eb !important;
            background-color: #ffffff !important;
        }

        /* Preset Quick Buttons */
        html:not(.dark) button.bg-slate-800 {
            background-color: #e2e8f0 !important;
            border-color: #cbd5e1 !important;
            color: #334155 !important;
        }
        html:not(.dark) button.bg-slate-800:hover {
            background-color: #cbd5e1 !important;
        }

        /* Tables */
        html:not(.dark) table thead {
            background-color: #e2e8f0 !important;
            border-color: #cbd5e1 !important;
            color: #475569 !important;
        }
        html:not(.dark) table tbody {
            background-color: #ffffff !important;
        }
        html:not(.dark) table tbody tr {
            border-color: #e2e8f0 !important;
        }
        html:not(.dark) table tbody tr:hover {
            background-color: #f8fafc !important;
        }
        html:not(.dark) td {
            color: #334155 !important;
        }

        /* Progress Bar Trackers */
        html:not(.dark) .bg-slate-800 {
            background-color: #cbd5e1 !important;
        }

        /* Rule Formula Blocks in Explainer */
        html:not(.dark) .bg-slate-900 {
            background-color: #e2e8f0 !important;
            color: #334155 !important;
        }

        /* Status & Alert Box Adjustments */
        html:not(.dark) #payoutCorrectionDetails {
            background-color: #ffffff !important;
            border-color: #cbd5e1 !important;
        }
        html:not(.dark) #sequenceStatusBanner.bg-slate-950 {
            background-color: #f1f5f9 !important;
            border-color: #cbd5e1 !important;
            color: #475569 !important;
        }

        /* Custom scrollbar for log table */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #0f172a;
        }
        html:not(.dark) ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 4px;
        }
        html:not(.dark) ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased">

    <!-- Header / Navbar -->
    <header class="border-b border-slate-800 bg-slate-900/80 backdrop-blur sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap justify-between items-center gap-4">
            <div class="flex items-center space-x-3">
                <div class="p-2 bg-brand-600/20 text-brand-500 rounded-lg border border-brand-500/30">
                    <i data-lucide="calculator" class="w-6 h-6"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold text-white dark:text-white dark-toggle-text tracking-tight flex items-center gap-2">
                        PropRisk <span class="text-xs px-2 py-0.5 rounded bg-brand-500/20 text-brand-400 font-semibold border border-brand-500/30">Consistency Lab</span>
                    </h1>
                    <p class="text-xs text-slate-400">Rules Engine & Payout Compliance Calculator</p>
                </div>
            </div>

            <!-- Theme Toggle Button & Quick Rule Info Chips -->
            <div class="flex items-center gap-3">
                <!-- Dark / Light Theme Switch Button -->
                <button onclick="toggleTheme()" id="themeBtn" class="flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs font-medium transition shadow-sm">
                    <i data-lucide="sun" id="themeIcon" class="w-4 h-4 text-amber-400"></i>
                    <span id="themeLabel">Light Mode</span>
                </button>

                <div class="hidden sm:flex items-center gap-2 text-xs">
                    <span class="bg-slate-800 border border-slate-700 px-2.5 py-1 rounded-md text-slate-300 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-blue-400"></span> 1-Step: <strong class="text-white">35% Cap</strong>
                    </span>
                    <span class="bg-slate-800 border border-slate-700 px-2.5 py-1 rounded-md text-slate-300 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-indigo-400"></span> 2-Step: <strong class="text-white">40% Cap</strong>
                    </span>
                    <span class="bg-slate-800 border border-slate-700 px-2.5 py-1 rounded-md text-slate-300 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Add-on: <strong class="text-white">50% Cap</strong>
                    </span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Top Configuration Bar -->
        <section class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-xl">
            <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-4 flex items-center gap-2">
                <i data-lucide="sliders" class="w-4 h-4 text-brand-500"></i> Account & Rule Setup
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                
                <!-- Account Size Input -->
                <div class="space-y-2">
                    <label class="text-xs font-medium text-slate-300 flex justify-between">
                        <span>Account Size ($)</span>
                        <span id="accountSizeDisplay" class="text-brand-400 font-bold">$100,000</span>
                    </label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-500">$</span>
                        <input type="number" id="accountSizeInput" value="100000" step="5000" min="1000"
                            class="w-full pl-8 pr-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white font-mono text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition">
                    </div>
                    <!-- Quick Presets -->
                    <div class="flex flex-wrap gap-1.5 pt-1">
                        <button onclick="setAccountSize(5000)" class="px-2 py-1 text-xs rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">5k</button>
                        <button onclick="setAccountSize(10000)" class="px-2 py-1 text-xs rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">10k</button>
                        <button onclick="setAccountSize(25000)" class="px-2 py-1 text-xs rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">25k</button>
                        <button onclick="setAccountSize(50000)" class="px-2 py-1 text-xs rounded bg-slate-800 hover:bg-slate-700 text-slate-300 border border-slate-700 transition">50k</button>
                        <button onclick="setAccountSize(100000)" class="px-2 py-1 text-xs rounded bg-slate-800 border border-brand-500/50 text-brand-400 font-medium transition">100k</button>
                    </div>
                </div>

                <!-- Challenge Type & Phase Selection -->
                <div class="space-y-2">
                    <label class="text-xs font-medium text-slate-300">Challenge Mode / Phase</label>
                    <select id="challengeTypeSelect" onchange="updateCalculator()"
                        class="w-full px-3 py-2 bg-slate-950 border border-slate-700 rounded-lg text-white text-sm focus:outline-none focus:border-brand-500 focus:ring-1 focus:ring-brand-500 transition">
                        <option value="1step">1-Step Challenge (Target: 10%)</option>
                        <option value="2step_p1">2-Step Challenge — Phase 1 (Target: 8%)</option>
                        <option value="2step_p2">2-Step Challenge — Phase 2 (Target: 5%)</option>
                        <option value="funded">Funded Phase / Payout Request</option>
                    </select>
                    <p id="challengeTypeDesc" class="text-[11px] text-slate-400 pt-0.5">
                        Single evaluation phase with 10% target and 35% consistency limit.
                    </p>
                </div>

                <!-- Rule Add-On Toggle -->
                <div class="space-y-2">
                    <label class="text-xs font-medium text-slate-300 flex items-center justify-between">
                        <span>Consistency Add-On / Rule Removal</span>
                        <span id="addonBadge" class="text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700">Standard</span>
                    </label>
                    <div class="p-2.5 bg-slate-950 border border-slate-700 rounded-lg flex items-center justify-between">
                        <div class="pr-2">
                            <span class="text-xs text-slate-200 block font-medium">No Consistency / Add-On</span>
                            <span class="text-[10px] text-slate-400">Increases max daily profit cap to 50%</span>
                        </div>
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="addonToggle" onchange="updateCalculator()" class="sr-only peer">
                            <div class="w-11 h-6 bg-slate-800 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-600"></div>
                        </label>
                    </div>
                </div>

                <!-- Summary Overview Box -->
                <div class="bg-slate-950/80 border border-slate-800 rounded-lg p-3.5 flex flex-col justify-between">
                    <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider flex items-center justify-between">
                        Active Consistency Limit
                        <i data-lucide="shield-alert" class="w-4 h-4 text-brand-400"></i>
                    </span>
                    <div class="mt-2 flex items-baseline justify-between">
                        <span id="activeLimitPct" class="text-2xl font-extrabold text-white">35%</span>
                        <span id="activeLimitFormula" class="text-xs font-mono text-slate-400">Target × 35%</span>
                    </div>
                    <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden mt-2">
                        <div id="limitBar" class="bg-brand-500 h-full transition-all duration-300" style="width: 35%;"></div>
                    </div>
                </div>

            </div>
        </section>

        <!-- Position & Account Limits + Maximum Lot Size Section -->
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Section 1.2.7 Position & Account Limit Checker (6 Cols) -->
            <div class="lg:col-span-6 bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-xl space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i data-lucide="layers" class="w-4 h-4 text-purple-400"></i> 1.2.7 Position & Account Limits
                    </h3>
                    <span class="px-2 py-0.5 text-[11px] font-medium rounded bg-purple-500/10 text-purple-300 border border-purple-500/20">
                        Rule Compliance
                    </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Position Limits Counter -->
                    <div class="bg-slate-950 p-3.5 rounded-lg border border-slate-800 space-y-3">
                        <span class="text-xs font-semibold text-slate-300 block">Open Positions Checker</span>
                        
                        <div class="space-y-2">
                            <div class="flex justify-between items-center text-xs">
                                <label class="text-slate-400">Positions in single asset:</label>
                                <input type="number" id="posPerAssetInput" value="3" min="0" max="10" oninput="checkPositionLimits()"
                                    class="w-16 px-2 py-1 bg-slate-900 border border-slate-700 rounded font-mono text-white text-right focus:border-brand-500">
                            </div>
                            <div id="posAssetStatus" class="text-[11px] px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex justify-between items-center">
                                <span>Max 5 per asset</span>
                                <strong class="font-mono">OK (3/5)</strong>
                            </div>
                        </div>

                        <div class="space-y-2 pt-2 border-t border-slate-800/80">
                            <div class="flex justify-between items-center text-xs">
                                <label class="text-slate-400">Total account positions:</label>
                                <input type="number" id="posTotalInput" value="8" min="0" max="25" oninput="checkPositionLimits()"
                                    class="w-16 px-2 py-1 bg-slate-900 border border-slate-700 rounded font-mono text-white text-right focus:border-brand-500">
                            </div>
                            <div id="posTotalStatus" class="text-[11px] px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex justify-between items-center">
                                <span>Max 13 total</span>
                                <strong class="font-mono">OK (8/13)</strong>
                            </div>
                        </div>
                    </div>

                    <!-- Trader Account Holdings Checker -->
                    <div class="bg-slate-950 p-3.5 rounded-lg border border-slate-800 space-y-3">
                        <span class="text-xs font-semibold text-slate-300 block">Trader Account Limits</span>

                        <div class="space-y-2">
                            <div class="flex justify-between items-center text-xs">
                                <label class="text-slate-400">Active challenge accounts:</label>
                                <input type="number" id="accChallengeInput" value="2" min="0" max="10" oninput="checkAccountLimits()"
                                    class="w-16 px-2 py-1 bg-slate-900 border border-slate-700 rounded font-mono text-white text-right focus:border-brand-500">
                            </div>
                            <div id="accChallengeStatus" class="text-[11px] px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex justify-between items-center">
                                <span>Max 4 accounts</span>
                                <strong class="font-mono">OK (2/4)</strong>
                            </div>
                        </div>

                        <div class="space-y-2 pt-2 border-t border-slate-800/80">
                            <div class="flex justify-between items-center text-xs">
                                <label class="text-slate-400">Live (funded) accounts:</label>
                                <input type="number" id="accLiveInput" value="1" min="0" max="5" oninput="checkAccountLimits()"
                                    class="w-16 px-2 py-1 bg-slate-900 border border-slate-700 rounded font-mono text-white text-right focus:border-brand-500">
                            </div>
                            <div id="accLiveStatus" class="text-[11px] px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex justify-between items-center">
                                <span>Max 1 live account</span>
                                <strong class="font-mono">OK (1/1)</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 1.2.8 Maximum Lot Sizes Calculator (6 Cols) -->
            <div class="lg:col-span-6 bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-xl space-y-4">
                <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                        <i data-lucide="scale" class="w-4 h-4 text-brand-400"></i> 1.2.8 BloomFunded Max Lot Sizes
                    </h3>
                    <span class="px-2 py-0.5 text-[11px] font-medium rounded bg-brand-500/10 text-brand-300 border border-brand-500/20">
                        Risk Management
                    </span>
                </div>

                <!-- Lot Size Asset Matrix -->
                <div class="space-y-3">
                    <div class="flex items-center justify-between text-xs">
                        <label class="text-slate-300 font-medium">Select Trading Asset:</label>
                        <select id="assetSelect" onchange="calculateMaxLotSize()" class="px-2.5 py-1 bg-slate-950 border border-slate-700 rounded text-xs text-white">
                            <option value="Volatility 25">Volatility 25</option>
                        </select>
                    </div>

                    <div class="bg-slate-950 p-3.5 rounded-lg border border-slate-800 space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="text-xs text-slate-400">Max Allowed Lot Size for <span id="lotAccSizeDisplay" class="text-white font-bold">$100,000</span>:</span>
                            <span id="maxLotSizeDisplay" class="text-xl font-mono font-bold text-brand-400">38.4 Lots</span>
                        </div>

                        <!-- Lot Size Checker -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-slate-800">
                            <div>
                                <label class="text-[11px] text-slate-400 block mb-1">Test Planned Lot Size:</label>
                                <input type="number" id="testLotInput" value="20" step="0.1" oninput="testLotCompliance()"
                                    class="w-full px-2.5 py-1.5 bg-slate-900 border border-slate-700 rounded text-white font-mono text-xs focus:outline-none focus:border-brand-500">
                            </div>
                            <div id="lotComplianceResult" class="p-2 rounded border text-xs flex items-center justify-between bg-emerald-500/10 text-emerald-400 border-emerald-500/30">
                                <span class="flex items-center gap-1"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Compliant</span>
                                <span id="lotUsagePct" class="font-mono text-[11px]">52.1% of max</span>
                            </div>
                        </div>
                    </div>

                    <!-- Lot Reference Table -->
                    <div class="overflow-x-auto rounded border border-slate-800 text-[11px]">
                        <table class="w-full text-left text-slate-300">
                            <thead class="bg-slate-950 text-slate-400 border-b border-slate-800">
                                <tr>
                                    <th class="p-2">Asset</th>
                                    <th class="p-2">5k</th>
                                    <th class="p-2">10k</th>
                                    <th class="p-2">25k</th>
                                    <th class="p-2">50k</th>
                                    <th class="p-2">100k</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-800/60 font-mono">
                                <tr>
                                    <td class="p-2 font-sans text-slate-200 font-medium">Volatility 25</td>
                                    <td class="p-2 text-slate-400">1.92</td>
                                    <td class="p-2 text-slate-400">3.84</td>
                                    <td class="p-2 text-slate-400">9.60</td>
                                    <td class="p-2 text-slate-400">19.20</td>
                                    <td class="p-2 text-brand-400 font-bold">38.40</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </section>

        <!-- Main Dashboard Split View -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Left Side: Dynamic Metrics & Analysis Panel (7 Cols) -->
            <div class="lg:col-span-7 space-y-6">

                <!-- Challenge Phase View (Shown when 1step or 2step selected) -->
                <div id="challengeSection" class="bg-slate-900 border border-slate-800 rounded-xl p-5 shadow-xl space-y-5">
                    <div class="flex items-center justify-between border-b border-slate-800 pb-3">
                        <h3 class="text-sm font-bold text-white flex items-center gap-2">
                            <i data-lucide="target" class="w-4 h-4 text-brand-500"></i> Challenge Evaluation Metrics
                        </h3>
                        <span id="challengeStatusBadge" class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Standard Limits Active
                        </span>
                    </div>

                    <!-- Core Metrics Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div class="bg-slate-950 p-4 rounded-lg border border-slate-800">
                            <span class="text-xs text-slate-400 block mb-1">Required Profit Target</span>
                            <div class="flex items-baseline justify-between">
                                <span id="calcProfitTarget" class="text-2xl font-bold text-white font-mono">$10,000</span>
                                <span id="calcTargetPct" class="text-xs text-brand-400 font-semibold">(10%)</span>
                            </div>
