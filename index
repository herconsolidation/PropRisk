    <!-- App Logic -->
    <script>
        // State variables
        let accountSize = 100000;
        let challengeType = '1step'; // '1step', '2step_p1', '2step_p2', 'funded'
        let addonActive = false;
        let isDarkMode = true;
        let dailyLogs = [
            { day: 1, profit: 1200 },
            { day: 2, profit: 1800 },
            { day: 3, profit: 900 }
        ];

        // Theme Toggle Function
        function toggleTheme() {
            isDarkMode = !isDarkMode;
            const htmlEl = document.documentElement;
            const themeBtn = document.getElementById('themeBtn');
            const themeIcon = document.getElementById('themeIcon');
            const themeLabel = document.getElementById('themeLabel');

            if (isDarkMode) {
                htmlEl.classList.add('dark');
                document.body.className = "bg-slate-950 text-slate-100 min-h-screen flex flex-col antialiased";
                if (themeLabel) themeLabel.innerText = "Light Mode";
                if (themeIcon) {
                    themeIcon.setAttribute('data-lucide', 'sun');
                    themeIcon.className = "w-4 h-4 text-amber-400";
                }
            } else {
                htmlEl.classList.remove('dark');
                document.body.className = "bg-slate-50 text-slate-900 min-h-screen flex flex-col antialiased";
                if (themeLabel) themeLabel.innerText = "Dark Mode";
                if (themeIcon) {
                    themeIcon.setAttribute('data-lucide', 'moon');
                    themeIcon.className = "w-4 h-4 text-indigo-600";
                }
            }

            if (window.lucide) {
                lucide.createIcons();
            }
        }

        // Lot Size Scaling Reference (base per $1k = 0.384 for Volatility 25)
        const LOT_TABLE = {
            'Volatility 25': {
                5000: 1.92,
                10000: 3.84,
                25000: 9.60,
                50000: 19.20,
                100000: 38.40
            }
        };

        // Rule Matrix Definition
        const RULES = {
            '1step': {
                name: '1-Step Challenge',
                targetPct: 0.10,
                defaultLimitPct: 0.35,
                addonLimitPct: 0.50,
                desc: '10% target, standard 35% daily profit limit.'
            },
            '2step_p1': {
                name: '2-Step Challenge (Phase 1)',
                targetPct: 0.08,
                defaultLimitPct: 0.40,
                addonLimitPct: 0.50,
                desc: '8% target, standard 40% daily profit limit.'
            },
            '2step_p2': {
                name: '2-Step Challenge (Phase 2)',
                targetPct: 0.05,
                defaultLimitPct: 0.40,
                addonLimitPct: 0.50,
                desc: '5% target, standard 40% daily profit limit.'
            },
            'funded': {
                name: 'Funded Phase (Payout)',
                targetPct: null, // based on payout request
                defaultLimitPct: 0.35,
                addonLimitPct: 0.50,
                desc: '35% cap applied directly to requested payout amount.'
            }
        };

        // Initialize icons and UI
        window.onload = function() {
            if (window.lucide) {
                lucide.createIcons();
            }
            
            // Event listener for account size input
            document.getElementById('accountSizeInput').addEventListener('input', function(e) {
                const val = parseFloat(e.target.value);
                accountSize = isNaN(val) || val <= 0 ? 0 : val;
                document.getElementById('accountSizeDisplay').innerText = '$' + accountSize.toLocaleString();
                updateCalculator();
            });

            updateCalculator();
            checkPositionLimits();
            checkAccountLimits();
            calculateMaxLotSize();
            renderDailyLogs();
        };

        function setAccountSize(size) {
            accountSize = size;
            document.getElementById('accountSizeInput').value = size;
            document.getElementById('accountSizeDisplay').innerText = '$' + size.toLocaleString();
            updateCalculator();
        }

        function updateCalculator() {
            challengeType = document.getElementById('challengeTypeSelect').value;
            addonActive = document.getElementById('addonToggle').checked;

            const rule = RULES[challengeType];

            // Update Addon badge
            const addonBadge = document.getElementById('addonBadge');
            if (addonBadge) {
                if (addonActive) {
                    addonBadge.innerText = 'Add-On Active';
                    addonBadge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
                } else {
                    addonBadge.innerText = 'Standard';
                    addonBadge.className = 'text-[10px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700';
                }
            }

            // Calculate Effective Cap Percentage
            const effectiveLimitPct = addonActive ? rule.addonLimitPct : rule.defaultLimitPct;

            // Update Header Bar UI
            const activeLimitPctElem = document.getElementById('activeLimitPct');
            if (activeLimitPctElem) activeLimitPctElem.innerText = (effectiveLimitPct * 100) + '%';
            const limitBarElem = document.getElementById('limitBar');
            if (limitBarElem) limitBarElem.style.width = (effectiveLimitPct * 100) + '%';
            const challengeDescElem = document.getElementById('challengeTypeDesc');
            if (challengeDescElem) challengeDescElem.innerText = rule.desc;

            if (challengeType === 'funded') {
                const formulaElem = document.getElementById('activeLimitFormula');
                if (formulaElem) formulaElem.innerText = 'Payout × ' + (effectiveLimitPct * 100) + '%';
                document.getElementById('challengeSection').classList.add('hidden');
                document.getElementById('fundedSection').classList.remove('hidden');
                calculatePayoutConsistency();
            } else {
                const formulaElem = document.getElementById('activeLimitFormula');
                if (formulaElem) formulaElem.innerText = 'Target × ' + (effectiveLimitPct * 100) + '%';
                document.getElementById('challengeSection').classList.remove('hidden');
                document.getElementById('fundedSection').classList.add('hidden');

                // Compute Challenge Metrics
                const profitTarget = accountSize * rule.targetPct;
                const maxDayProfit = profitTarget * effectiveLimitPct;

                document.getElementById('calcProfitTarget').innerText = '$' + profitTarget.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 2});
                document.getElementById('calcTargetPct').innerText = '(' + (rule.targetPct * 100) + '%)';
                document.getElementById('calcMaxDayProfit').innerText = '$' + maxDayProfit.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 2});
                document.getElementById('calcMaxDayPct').innerText = '(' + (effectiveLimitPct * 100) + '% of Target)';

                testSingleDay();
            }

            calculateMaxLotSize();
            renderDailyLogs();
            updateDynamicExample();
        }

        // Section 1.2.7: Check Position Limits
        function checkPositionLimits() {
            const posPerAsset = parseInt(document.getElementById('posPerAssetInput').value) || 0;
            const posTotal = parseInt(document.getElementById('posTotalInput').value) || 0;

            const assetStatus = document.getElementById('posAssetStatus');
            if (assetStatus) {
                if (posPerAsset <= 5) {
                    assetStatus.className = 'text-[11px] px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex justify-between items-center';
                    assetStatus.innerHTML = `<span>Max 5 per asset</span><strong class="font-mono">OK (${posPerAsset}/5)</strong>`;
                } else {
                    assetStatus.className = 'text-[11px] px-2 py-1 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20 flex justify-between items-center';
                    assetStatus.innerHTML = `<span>Exceeds Limit!</span><strong class="font-mono">BREACH (${posPerAsset}/5)</strong>`;
                }
            }

            const totalStatus = document.getElementById('posTotalStatus');
            if (totalStatus) {
                if (posTotal <= 13) {
                    totalStatus.className = 'text-[11px] px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex justify-between items-center';
                    totalStatus.innerHTML = `<span>Max 13 total</span><strong class="font-mono">OK (${posTotal}/13)</strong>`;
                } else {
                    totalStatus.className = 'text-[11px] px-2 py-1 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20 flex justify-between items-center';
                    totalStatus.innerHTML = `<span>Exceeds Limit!</span><strong class="font-mono">BREACH (${posTotal}/13)</strong>`;
                }
            }
        }

        // Section 1.2.7: Check Account Limits
        function checkAccountLimits() {
            const challengeAcc = parseInt(document.getElementById('accChallengeInput').value) || 0;
            const liveAcc = parseInt(document.getElementById('accLiveInput').value) || 0;

            const chStatus = document.getElementById('accChallengeStatus');
            if (chStatus) {
                if (challengeAcc <= 4) {
                    chStatus.className = 'text-[11px] px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex justify-between items-center';
                    chStatus.innerHTML = `<span>Max 4 accounts</span><strong class="font-mono">OK (${challengeAcc}/4)</strong>`;
                } else {
                    chStatus.className = 'text-[11px] px-2 py-1 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20 flex justify-between items-center';
                    chStatus.innerHTML = `<span>Exceeds Limit!</span><strong class="font-mono">BREACH (${challengeAcc}/4)</strong>`;
                }
            }

            const liveStatus = document.getElementById('accLiveStatus');
            if (liveStatus) {
                if (liveAcc <= 1) {
                    liveStatus.className = 'text-[11px] px-2 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 flex justify-between items-center';
                    liveStatus.innerHTML = `<span>Max 1 live account</span><strong class="font-mono">OK (${liveAcc}/1)</strong>`;
                } else {
                    liveStatus.className = 'text-[11px] px-2 py-1 rounded bg-rose-500/10 text-rose-400 border border-rose-500/20 flex justify-between items-center';
                    liveStatus.innerHTML = `<span>Exceeds Limit!</span><strong class="font-mono">BREACH (${liveAcc}/1)</strong>`;
                }
            }
        }

        // Section 1.2.8: Calculate Maximum Lot Size for active account size
        function getMaxLotForAccount(asset, size) {
            if (LOT_TABLE[asset] && LOT_TABLE[asset][size]) {
                return LOT_TABLE[asset][size];
            }
            // Linear scale if custom account size (e.g. 0.000384 per dollar for Volatility 25)
            return (size * 0.000384);
        }

        function calculateMaxLotSize() {
            const asset = document.getElementById('assetSelect').value;
            const maxLot = getMaxLotForAccount(asset, accountSize);

            document.getElementById('lotAccSizeDisplay').innerText = '$' + accountSize.toLocaleString();
            document.getElementById('maxLotSizeDisplay').innerText = maxLot.toFixed(2) + ' Lots';

            testLotCompliance();
        }

        function testLotCompliance() {
            const asset = document.getElementById('assetSelect').value;
            const maxLot = getMaxLotForAccount(asset, accountSize);
            const plannedLot = parseFloat(document.getElementById('testLotInput').value) || 0;

            const compRes = document.getElementById('lotComplianceResult');
            const usagePct = maxLot > 0 ? (plannedLot / maxLot) * 100 : 0;

            if (compRes) {
                if (plannedLot <= maxLot) {
                    compRes.className = 'p-2 rounded border text-xs flex items-center justify-between bg-emerald-500/10 text-emerald-400 border-emerald-500/30';
                    compRes.innerHTML = `<span class="flex items-center gap-1"><i data-lucide="check-circle" class="w-3.5 h-3.5"></i> Within Limit</span><span id="lotUsagePct" class="font-mono text-[11px]">${usagePct.toFixed(1)}% of max</span>`;
                } else {
                    compRes.className = 'p-2 rounded border text-xs flex items-center justify-between bg-rose-500/10 text-rose-400 border-rose-500/30';
                    compRes.innerHTML = `<span class="flex items-center gap-1"><i data-lucide="alert-triangle" class="w-3.5 h-3.5"></i> Exceeds Max Lot</span><span id="lotUsagePct" class="font-mono text-[11px]">${usagePct.toFixed(1)}% of max</span>`;
                }
            }

            if (window.lucide) {
                lucide.createIcons();
            }
        }

        // Test single day input for challenge mode
        function testSingleDay() {
            if (challengeType === 'funded') return;

            const inputElem = document.getElementById('quickTestProfit');
            if (!inputElem) return;

            const inputVal = parseFloat(inputElem.value) || 0;
            const rule = RULES[challengeType];
            const effectiveLimitPct = addonActive ? rule.addonLimitPct : rule.defaultLimitPct;
            const profitTarget = accountSize * rule.targetPct;
            const maxDayProfit = profitTarget * effectiveLimitPct;

            const sharePct = profitTarget > 0 ? (inputVal / profitTarget) * 100 : 0;
            const quickRes = document.getElementById('quickTestResult');

            if (quickRes) {
                if (inputVal <= maxDayProfit) {
                    quickRes.className = 'p-2.5 rounded border text-xs font-medium flex items-center justify-between bg-emerald-500/10 text-emerald-400 border-emerald-500/30';
                    quickRes.innerHTML = `
                        <span class="flex items-center gap-1.5"><i data-lucide="check-circle-2" class="w-4 h-4"></i> Within Limit</span>
                        <span id="quickTestShare" class="font-mono">${sharePct.toFixed(1)}% of target</span>
                    `;
                } else {
                    quickRes.className = 'p-2.5 rounded border text-xs font-medium flex items-center justify-between bg-rose-500/10 text-rose-400 border-rose-500/30';
                    quickRes.innerHTML = `
                        <span class="flex items-center gap-1.5"><i data-lucide="alert-octagon" class="w-4 h-4"></i> Exceeds Consistency</span>
                        <span id="quickTestShare" class="font-mono">${sharePct.toFixed(1)}% of target</span>
                    `;
                }
            }
            if (window.lucide) {
                lucide.createIcons();
            }
        }

        // Funded Phase Calculation Logic
        function calculatePayoutConsistency() {
            const payoutReq = parseFloat(document.getElementById('payoutRequestInput').value) || 0;
            const highestDay = parseFloat(document.getElementById('highestDayInput').value) || 0;

            const rule = RULES['funded'];
            const effectiveLimitPct = addonActive ? rule.addonLimitPct : rule.defaultLimitPct;

            const maxAllowedDay = payoutReq * effectiveLimitPct;
            const shareOfReq = payoutReq > 0 ? (highestDay / payoutReq) * 100 : 0;

            document.getElementById('fundedMaxAllowed').innerText = '$' + maxAllowedDay.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 2});
            document.getElementById('fundedHighestShare').innerText = shareOfReq.toFixed(1) + '%';

            const statusBox = document.getElementById('payoutStatusBox');
            const statusIcon = document.getElementById('payoutStatusIcon');
            const statusTitle = document.getElementById('payoutStatusTitle');
            const statusDesc = document.getElementById('payoutStatusDesc');
            const statusBadge = document.getElementById('payoutStatusBadge');
            const detailsBox = document.getElementById('payoutCorrectionDetails');

            if (highestDay <= maxAllowedDay) {
                // Compliant
                statusBox.className = 'p-4 rounded-xl border transition-all duration-300 space-y-3 bg-emerald-500/10 border-emerald-500/30 text-emerald-300';
                statusIcon.className = 'p-2 rounded-lg bg-emerald-500/20 text-emerald-400';
                statusIcon.innerHTML = '<i data-lucide="check-circle-2" class="w-5 h-5"></i>';
                statusTitle.innerText = 'Payout Request Approved';
                statusDesc.innerText = `Highest daily profit ($${highestDay.toLocaleString()}) is within the permitted cap of ${effectiveLimitPct * 100}%.`;
                statusBadge.innerText = 'Approved';
                statusBadge.className = 'text-xs font-bold uppercase px-2.5 py-1 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/40';
                
                detailsBox.classList.add('hidden');
            } else {
                // Non-compliant / Exceeds Limit
                statusBox.className = 'p-4 rounded-xl border transition-all duration-300 space-y-3 bg-amber-500/10 border-amber-500/30 text-amber-300';
                statusIcon.className = 'p-2 rounded-lg bg-amber-500/20 text-amber-400';
                statusIcon.innerHTML = '<i data-lucide="alert-triangle" class="w-5 h-5"></i>';
                statusTitle.innerText = 'Payout Limit Exceeded';
                statusDesc.innerText = `Highest single daily profit ($${highestDay.toLocaleString()}) exceeds the allowed limit of $${maxAllowedDay.toLocaleString()}.`;
                statusBadge.innerText = 'Needs More Profit';
                statusBadge.className = 'text-xs font-bold uppercase px-2.5 py-1 rounded bg-amber-500/20 text-amber-300 border border-amber-500/40';

                // Calculate required target payout
                const reqTarget = highestDay / effectiveLimitPct;
                const addProfit = reqTarget - payoutReq;

                document.getElementById('reqPayoutTarget').innerText = '$' + reqTarget.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
                document.getElementById('reqAdditionalProfit').innerText = '+$' + addProfit.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});

                detailsBox.classList.remove('hidden');
            }
            lucide.createIcons();
        }

        // Multi-Day Simulator Log Management
        function addDailyRow() {
            const nextDay = dailyLogs.length + 1;
            dailyLogs.push({ day: nextDay, profit: 1000 });
            renderDailyLogs();
        }

        function removeDailyRow(index) {
            dailyLogs.splice(index, 1);
            // Re-index days
            dailyLogs.forEach((item, idx) => item.day = idx + 1);
            renderDailyLogs();
        }

        function updateDailyProfit(index, val) {
            dailyLogs[index].profit = parseFloat(val) || 0;
            renderDailyLogs();
        }

        function clearDailyLogs() {
            dailyLogs = [];
            renderDailyLogs();
        }

        function renderDailyLogs() {
            const tbody = document.getElementById('dailyLogTbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const rule = RULES[challengeType];
            const effectiveLimitPct = addonActive ? rule.addonLimitPct : rule.defaultLimitPct;

            let targetBase = 0;
            if (challengeType === 'funded') {
                targetBase = parseFloat(document.getElementById('payoutRequestInput').value) || 0;
            } else {
                targetBase = accountSize * rule.targetPct;
            }

            const maxAllowedSingleDay = targetBase * effectiveLimitPct;
            let totalProfit = 0;
            let highestDayVal = 0;
            let breachCount = 0;

            dailyLogs.forEach((item, index) => {
                totalProfit += item.profit;
                if (item.profit > highestDayVal) highestDayVal = item.profit;

                const sharePct = targetBase > 0 ? (item.profit / targetBase) * 100 : 0;
                const isBreached = item.profit > maxAllowedSingleDay;
                if (isBreached) breachCount++;

                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-800/40 transition';
                tr.innerHTML = `
                    <td class="p-2.5 font-medium text-slate-300">Day ${item.day}</td>
                    <td class="p-2.5">
                        <input type="number" value="${item.profit}" onchange="updateDailyProfit(${index}, this.value)"
                            class="w-28 px-2 py-1 bg-slate-950 border border-slate-700 rounded text-white font-mono text-xs focus:outline-none focus:border-brand-500">
                    </td>
                    <td class="p-2.5 text-center font-mono ${sharePct > (effectiveLimitPct * 100) ? 'text-rose-400 font-bold' : 'text-slate-300'}">
                        ${sharePct.toFixed(1)}%
                    </td>
                    <td class="p-2.5 text-center">
                        ${isBreached ? 
                            `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30">Exceeds Cap</span>` : 
                            `<span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">OK</span>`}
                    </td>
                    <td class="p-2.5 text-right">
                        <button onclick="removeDailyRow(${index})" class="text-slate-500 hover:text-rose-400 transition p-1">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            // Update Progress Summary
            const totalProfitElem = document.getElementById('logTotalProfit');
            if (totalProfitElem) totalProfitElem.innerText = '$' + totalProfit.toLocaleString(undefined, {minimumFractionDigits: 0, maximumFractionDigits: 2});
            const highestDayElem = document.getElementById('logHighestDaySummary');
            if (highestDayElem) highestDayElem.innerText = 'Highest Day: $' + highestDayVal.toLocaleString();

            const progressPct = targetBase > 0 ? Math.min((totalProfit / targetBase) * 100, 100) : 0;
            const logProgressElem = document.getElementById('logProgressBar');
            if (logProgressElem) logProgressElem.style.width = progressPct + '%';
            const logProgressPctElem = document.getElementById('logProgressPct');
            if (logProgressPctElem) logProgressPctElem.innerText = progressPct.toFixed(1) + '% of target accumulated';

            // Sequence Banner Alert
            const banner = document.getElementById('sequenceStatusBanner');
            if (banner) {
                if (dailyLogs.length === 0) {
                    banner.className = 'p-3 rounded-lg text-xs flex items-center justify-between border bg-slate-950 border-slate-800 text-slate-400';
                    banner.innerHTML = `<span class="flex items-center gap-2"><i data-lucide="info" class="w-4 h-4"></i> Add trading days to simulate multi-day sequence compliance.</span>`;
                } else if (breachCount > 0) {
                    banner.className = 'p-3 rounded-lg text-xs flex items-center justify-between border bg-rose-500/10 border-rose-500/30 text-rose-300';
                    banner.innerHTML = `<span class="flex items-center gap-2 font-semibold"><i data-lucide="alert-octagon" class="w-4 h-4 text-rose-400"></i> Non-Compliant Sequence: ${breachCount} trading day(s) exceed the ${effectiveLimitPct * 100}% cap.</span>`;
                } else if (totalProfit >= targetBase) {
                    banner.className = 'p-3 rounded-lg text-xs flex items-center justify-between border bg-emerald-500/10 border-emerald-500/30 text-emerald-300';
                    banner.innerHTML = `<span class="flex items-center gap-2 font-semibold"><i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i> Target Reached & Fully Compliant! Sequence passes all consistency rules.</span>`;
                } else {
                    banner.className = 'p-3 rounded-lg text-xs flex items-center justify-between border bg-blue-500/10 border-blue-500/30 text-blue-300';
                    banner.innerHTML = `<span class="flex items-center gap-2"><i data-lucide="shield-check" class="w-4 h-4 text-blue-400"></i> Sequence Compliant so far. Need $${(targetBase - totalProfit).toLocaleString()} more profit to hit target.</span>`;
                }
            }

            if (window.lucide) {
                lucide.createIcons();
            }
        }

        // Dynamic Example Walkthrough Text Generator
        function updateDynamicExample() {
            const rule = RULES[challengeType];
            const effectiveLimitPct = addonActive ? rule.addonLimitPct : rule.defaultLimitPct;
            const exContainer = document.getElementById('exampleBox');
            if (!exContainer) return;

            if (challengeType === 'funded') {
                const payoutReq = parseFloat(document.getElementById('payoutRequestInput').value) || 4000;
                const maxAllowed = payoutReq * effectiveLimitPct;
                exContainer.innerHTML = `
                    <p>For a requested payout of <strong class="text-white">$${payoutReq.toLocaleString()}</strong> under the <strong>${effectiveLimitPct * 100}%</strong> consistency limit:</p>
                    <ul class="list-disc pl-4 space-y-1 text-slate-400">
                        <li>Maximum single profitable day permitted = <strong class="text-amber-400">$${maxAllowed.toLocaleString()}</strong>.</li>
                        <li>If your highest day is <strong>$1,200</strong> &rarr; Approved!</li>
                        <li>If your highest day is <strong>$1,800</strong> &rarr; Needs more profit! Target = $1,800 / ${effectiveLimitPct} = <strong class="text-emerald-400">$${(1800/effectiveLimitPct).toLocaleString()}</strong> total payout requirement.</li>
                    </ul>
                `;
            } else {
                const target = accountSize * rule.targetPct;
                const maxAllowed = target * effectiveLimitPct;
                exContainer.innerHTML = `
                    <p>For a <strong class="text-white">$${accountSize.toLocaleString()}</strong> account on <strong>${rule.name}</strong>:</p>
                    <ul class="list-disc pl-4 space-y-1 text-slate-400">
                        <li>Profit Target (${rule.targetPct * 100}%) = <strong class="text-white">$${target.toLocaleString()}</strong>.</li>
                        <li>Consistency Cap (${effectiveLimitPct * 100}%) = <strong class="text-amber-400">$${maxAllowed.toLocaleString()}</strong> per trading day.</li>
                        <li>If Day 1 profit is $3,000, and cap is $2,800 &rarr; Breach! Account fails consistency.</li>
                        <li>Keep all daily gains under <strong class="text-emerald-400">$${maxAllowed.toLocaleString()}</strong> while reaching $${target.toLocaleString()}.</li>
                    </ul>
                `;
            }
        }
    </script>
</body>
</html>
